# ============================================================
# Copie ce fichier en ".env" et remplis tes propres valeurs.
# NE JAMAIS committer le fichier ".env" réel dans git !
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
# Chaîne de connexion Postgres directe fournie par Supabase (Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# --- PostgreSQL classique ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=my_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=my_database
MYSQL_USER=root
MYSQL_PASSWORD=changeme

# --- SQLite ---
# Chemin vers le fichier local (créé automatiquement s'il n'existe pas)
SQLITE_DB_PATH=./data/local_database.db

# --- Divers ---
LOG_LEVEL=INFO
